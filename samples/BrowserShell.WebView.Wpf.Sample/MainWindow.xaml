<chrome:ChromeWindow x:Class="BrowserShell.WebView.Wpf.Sample.MainWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:chrome="https://windowchromekit.dev/wpf"
                     Title="BrowserShell 示例"
                     Icon="{x:Static chrome:WindowChromeIcons.Windows10}"
                     Width="880"
                     Height="620"
                     MinWidth="620"
                     MinHeight="460"
                     TitleBarStyle="VsCode"
                     TitleBarPalette="ElementPlusDark"
                     WindowStartupLocation="CenterScreen">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部说明 -->
        <StackPanel Grid.Row="0" Margin="20,18,20,10">
            <TextBlock Text="BrowserShell.WebView.Wpf"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#E6E6E6" />
            <TextBlock Margin="0,6,0,0"
                       Text="在 WindowChromeKit 的 ChromeWindow 上承载 WebView2。窗口边框、拖动、Snap 由 ChromeWindow 提供，本库只负责内容承载。"
                       TextWrapping="Wrap"
                       Foreground="#9D9D9D" />
        </StackPanel>

        <!-- 选项 -->
        <Border Grid.Row="1"
                Margin="20,6,20,10"
                Padding="16"
                Background="#252526"
                BorderBrush="#333337"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Margin="0,0,0,12"
                           VerticalAlignment="Center"
                           Text="地址"
                           Foreground="#CCCCCC" />
                <TextBox x:Name="UrlBox"
                         Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                         Margin="0,0,0,12"
                         Padding="6,4"
                         Text="https://www.bing.com" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Margin="0,0,0,12"
                           VerticalAlignment="Center"
                           Text="标题栏样式"
                           Foreground="#CCCCCC" />
                <ComboBox x:Name="StyleBox"
                          Grid.Row="1" Grid.Column="1"
                          Margin="0,0,12,12" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Margin="0,0,0,12"
                           VerticalAlignment="Center"
                           Text="标题栏配色"
                           Foreground="#CCCCCC" />
                <ComboBox x:Name="PaletteBox"
                          Grid.Row="2" Grid.Column="1"
                          Margin="0,0,12,12" />

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Margin="0,0,0,12"
                           VerticalAlignment="Center"
                           Text="冲突处理"
                           Foreground="#CCCCCC" />
                <ComboBox x:Name="ClosingBox"
                          Grid.Row="3" Grid.Column="1"
                          Margin="0,0,12,12" />

                <CheckBox x:Name="TopmostBox"
                          Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                          Margin="0,0,0,12"
                          VerticalAlignment="Center"
                          Content="窗口置顶"
                          Foreground="#CCCCCC" />

                <CheckBox x:Name="ResizableBox"
                          Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                          Margin="0,0,0,12"
                          VerticalAlignment="Center"
                          IsChecked="True"
                          Content="允许调整大小"
                          Foreground="#CCCCCC" />

                <CheckBox x:Name="OriginsBox"
                          Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2"
                          Margin="0,0,0,12"
                          VerticalAlignment="Center"
                          Content="限制为同源导航"
                          Foreground="#CCCCCC" />

                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4"
                           VerticalAlignment="Bottom"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="#8A8A8A"
                           Text="提示：打开窗口后，可在页面控制台调用 browserShell.window.minimize() / maximize() / restore() / close()。" />
            </Grid>
        </Border>

        <!-- 操作区 -->
        <StackPanel Grid.Row="2"
                    Margin="20,0,20,18"
                    Orientation="Horizontal">
            <Button x:Name="OpenButton"
                    Padding="18,7"
                    Click="OnOpenClick"
                    Content="打开 Web 窗口" />
            <Button x:Name="LocalButton"
                    Margin="10,0,0,0"
                    Padding="18,7"
                    Click="OnOpenLocalClick"
                    Content="打开本地示例页" />
            <Button x:Name="CloseAllButton"
                    Margin="10,0,0,0"
                    Padding="18,7"
                    Click="OnCloseAllClick"
                    Content="关闭全部" />
            <TextBlock x:Name="StatusText"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#7FB069" />
        </StackPanel>
    </Grid>
</chrome:ChromeWindow>
