<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>2.0.0</Version>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>BrowserShell.Service.SDK</PackageId>
    <AssemblyName>BrowserShell.Service.SDK</AssemblyName>
    <RootNamespace>BrowserShell.Service.SDK</RootNamespace>
    <Description>BrowserShell 窗口能力 SDK：服务通过它打开与管理桌面窗口。</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- 生命周期重载按有/无强类型委托明确区分；保留默认 CancellationToken 的调用体验。 -->
    <NoWarn>$(NoWarn);RS0026</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    <None Update="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BrowserShell.WebView.Wpf" />
    <InternalsVisibleTo Include="BrowserShell.WebView.Wpf.Tests" />
  </ItemGroup>
</Project>